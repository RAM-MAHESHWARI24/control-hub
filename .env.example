# ==============================================================================
# Control Hub - configuration template
# Used by: config.py, server.py and widgets/*.py
# ==============================================================================
# Standalone use:  cp .env.example .env   then edit.
# Blueprint install: the installer renders /etc/homelab/control-hub.env and
# symlinks it here, so you normally never edit this file by hand.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP binding and access token (REQUIRED)
# ------------------------------------------------------------------------------
# Interface to listen on. 0.0.0.0 = every interface (LAN access), 127.0.0.1 = local only.
CONTROL_HUB_HOST=0.0.0.0
CONTROL_HUB_PORT=7575

# Bearer token every /api request must carry (Authorization: Bearer <token>).
# The dashboard asks for it once and remembers it in the browser.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty only for local experiments: a random token is then printed at startup.
CONTROL_HUB_TOKEN=

# ------------------------------------------------------------------------------
# 2. Network throughput sampler
# ------------------------------------------------------------------------------
# Interface for live Rx/Tx sampling. Leave empty to auto-detect the default-route NIC.
ACTIVE_NIC=
# Negotiated link speed in Mbit/s, used for the capacity gauge (1000 = Gigabit).
LINK_SPEED_MBPS=1000

# ------------------------------------------------------------------------------
# 3. qBittorrent integration (download telemetry, pause/resume all)
# ------------------------------------------------------------------------------
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USER=admin
# Set to the password you configured in qBittorrent. No default is shipped.
QBITTORRENT_PASS=

# ------------------------------------------------------------------------------
# 4. Storage paths shown in the dashboard
# ------------------------------------------------------------------------------
HDD_DATA=/mnt/hdd/data

# ------------------------------------------------------------------------------
# 5. TV auto-updater integration (optional module)
# ------------------------------------------------------------------------------
# Inside the blueprint these resolve to the sibling apps/tv-autoupdater module.
# Uncomment only for a custom folder layout.
# TV_UPDATER_DIR=../tv-autoupdater
# TV_UPDATER_PY=../tv-autoupdater/tv_updater.py
# TV_UPDATER_STATE_FILE=/var/lib/homelab/tv-autoupdater/state.json
# TV_UPDATER_INCOMING_DIR=/var/lib/homelab/tv-autoupdater/incoming_apks
TV_UPDATER_LOG_FILE=/var/lib/homelab/tv-autoupdater/tv-autoupdater.log

# ------------------------------------------------------------------------------
# 6. Sleep Guard and backup files
# ------------------------------------------------------------------------------
SUSPEND_SKIP_FILE=/run/server-suspend.skip
SUSPEND_OVERRIDE_FILE=/run/server-suspend.override
SUSPEND_CONFIG_FILE=/etc/server-suspend.conf
SUSPEND_CRON_FILE=/etc/cron.d/server-suspend
SERVER_SUSPEND_LOG_FILE=/var/log/server-suspend.log

# Photo backup (noodle-gallery-tools) and ML scheduler logs, if those modules are installed
BACKUP_LOG_FILE=/opt/immich/backups/backup.log
BACKUP_DIR=/opt/immich/backups
IMMICH_ML_LOG_FILE=/var/log/immich-ml.log
RECYCLARR_LOG_FILE=/var/log/recyclarr.log

# ------------------------------------------------------------------------------
# 7. Ookla Speedtest integration (optional)
# ------------------------------------------------------------------------------
SPEEDTEST_BIN=/usr/local/bin/speedtest
SPEEDTEST_CACHE_FILE=./speedtest_cache.json
